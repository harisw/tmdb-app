local.file_match "laravel_logs" {
    path_targets    = [{
        __path__    = "/var/log/laravel/*.log",
        job         = "laravel",
        app         = "chill",
        env         = "production",
    }]
}

loki.source.file "laravel" {
    targets     = local.file_match.laravel_logs.targets
    forward_to  = [loki.process.laravel.receiver]
}

loki.process "laravel" {
    stage.multiline {
        firstline       = "^\\[\\d{4}-\\d{2}-\\d{2}"
        max_wait_time   = "3s"
    }

    stage.regex {
        expression = "^\\[(?P<time>\\S+ \\S+)\\] (?P<channel>\\w+)\\.(?P<level>\\w+): (?P<message>.+)"
    }

    stage.labels {
        values = {
            channel = null,
            level   = null,
        }
    }

    forward_to  = [loki.write.grafana_cloud.receiver]
}

// Ship to Grafana Cloud Loki
loki.write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_LOKI_URL")

    basic_auth {
      username = env("GRAFANA_LOKI_USER")
      password = env("GRAFANA_LOKI_PASSWORD")
    }
  }
}
