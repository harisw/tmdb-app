{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTargetResources",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "rds:DescribeDBInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageSchedulerRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::012504444753:role/chill-scheduler-*"
    },
    {
      "Sid": "PassSchedulerRolesToServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::012504444753:role/chill-scheduler-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "scheduler.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ManageSchedulerLambdas",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:GetPolicy",
        "lambda:ListVersionsByFunction",
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-2:012504444753:function:chill-*"
    },
    {
      "Sid": "ManageLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:StartQuery"
      ],
      "Resource": [
        "arn:aws:logs:ap-northeast-2:012504444753:log-group:/aws/lambda/chill-*",
        "arn:aws:logs:ap-northeast-2:012504444753:log-group:/aws/lambda/chill-*:*",
        "arn:aws:logs:ap-northeast-2:012504444753:log-group:/tmdb/app",
        "arn:aws:logs:ap-northeast-2:012504444753:log-group:/tmdb/app:*",
        "arn:aws:logs:ap-northeast-2:012504444753:log-group:/tmdb/horizon",
        "arn:aws:logs:ap-northeast-2:012504444753:log-group:/tmdb/horizon:*"
      ]
    },
    {
      "Sid": "LogsActionsWithoutResourceSupport",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:GetQueryResults",
        "logs:StopQuery",
        "logs:DescribeQueries"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageSchedules",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule",
        "scheduler:ListTagsForResource",
        "scheduler:TagResource",
        "scheduler:UntagResource"
      ],
      "Resource": "arn:aws:scheduler:ap-northeast-2:012504444753:schedule/default/chill-*"
    },
    {
      "Sid": "ListSchedulesRequiresWildcard",
      "Effect": "Allow",
      "Action": "scheduler:ListSchedules",
      "Resource": "*"
    },
    {
      "Sid": "InspectKmsKeys",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:ListAliases",
        "kms:ListKeys",
        "kms:ListGrants",
        "kms:ListRetirableGrants"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadCloudWatchMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
      {
    "Sid": "TerraformStateBucket",
    "Effect": "Allow",
    "Action": "s3:ListBucket",
    "Resource": "arn:aws:s3:::chill-tfstate-012504444753"
  },
  {
    "Sid": "TerraformStateObjects",
    "Effect": "Allow",
    "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
    "Resource": "arn:aws:s3:::chill-tfstate-012504444753/scheduling/*"
  }
  ]
}
